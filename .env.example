# Portfolio site (Vercel) — copy to .env.local for `vercel dev`
# Full URL to the chatbot app’s portfolio endpoint (no trailing slash on path segment is fine)
CHATBOT_PORTFOLIO_API_URL=https://your-chatbot-deployment.vercel.app/api/portfolio-chat

# Shared secret: must match PORTFOLIO_CHAT_SECRET on the chatbot project
PORTFOLIO_CHAT_SECRET=
